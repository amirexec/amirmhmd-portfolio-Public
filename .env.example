# Postgres — connected to your existing Supabase project (tgnlntzdngcqmdrrkxnf).
# Get the exact connection string from: Supabase dashboard → this project →
# Settings → Database → Connection string → "URI" (Session pooler is fine for
# this app size). It looks like:
# postgresql://postgres.tgnlntzdngcqmdrrkxnf:[YOUR-DB-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres
# I can't retrieve or reset that password myself — Supabase never exposes it
# over the API, only in the dashboard (or via "Reset database password" there
# if you've lost it).
DATABASE_URL="postgresql://postgres.tgnlntzdngcqmdrrkxnf:[YOUR-DB-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres"

# NextAuth
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# Admin bootstrap (used only by prisma/seed.ts to create the first admin —
# NOT needed for this Supabase project, an admin account with
# email "1" / password "1" was already seeded directly. Change this ASAP;
# see the chat for why.)
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="change-me-before-seeding"

# Media storage — S3-compatible (AWS S3 / Cloudflare R2 / Supabase Storage)
STORAGE_ENDPOINT=""           # leave empty for real AWS S3; set for R2/Supabase
STORAGE_REGION="auto"
STORAGE_BUCKET="amirmhmd-media"
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_PUBLIC_URL=""         # public base URL to prefix stored file keys with
