generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Auth / Admin ----------
model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
}

// ---------- Global site config ----------
model SiteSettings {
  id                String  @id @default("singleton")
  siteName          String  @default("Amirmhmd Bagheri")
  logoMediaId       String?
  faviconMediaId    String?
  seoTitle          String  @default("امیرمحمد باقری — فیلمساز و کارگردان خلاق")
  seoDescription    String  @default("فیلمساز، تدوین‌گر و کارگردان خلاق")
  socialPreviewId   String?
  instagramUrl      String?
  whatsappUrl       String?
  telegramUrl       String?
  email             String?
  phone             String?
  accentColor       String  @default("#a31621")
  backgroundColor   String  @default("#0c0a09")
  updatedAt         DateTime @updatedAt
}

// ---------- Homepage / About content (single-row editable blocks) ----------
model HomepageContent {
  id              String   @id @default("singleton")
  heroTagline     String   @default("«تصویر فقط دیده نمی‌شود؛ باید احساس شود.»")
  heroRoleLine    String   @default("FILMMAKER · VIDEO EDITOR · CREATIVE DIRECTOR")
  heroPortraitId  String?
  aboutHeading    String   @default("داستان من")
  aboutBody       String   @default("")
  aboutPortraitId String?
  showreelTitle   String   @default("Showreel 2026")
  showreelUrl     String?
  showreelThumbId String?
  showreelDesc    String   @default("")
  updatedAt       DateTime @updatedAt
}

// ---------- Portfolio ----------
model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  projects Project[]
}

model Project {
  id          String          @id @default(cuid())
  title       String
  client      String?
  year        Int
  role        String?
  description String?
  externalUrl String?
  published   Boolean         @default(false)
  order       Int             @default(0)
  categoryId  String?
  category    Category?       @relation(fields: [categoryId], references: [id])
  coverId     String?
  videoUrl    String?
  seoTitle    String?
  seoDesc     String?
  media       ProjectMedia[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model ProjectMedia {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  mediaId   String
  order     Int     @default(0)
}

// ---------- Services ----------
model Service {
  id          String  @id @default(cuid())
  title       String
  description String?
  mediaId     String?
  ctaLabel    String?
  ctaUrl      String?
  enabled     Boolean @default(true)
  order       Int     @default(0)
}

// ---------- Behind the scenes ----------
model BTSItem {
  id      String  @id @default(cuid())
  mediaId String
  caption String?
  order   Int     @default(0)
}

// ---------- Clients ----------
model Client {
  id      String  @id @default(cuid())
  name    String
  logoId  String
  url     String?
  order   Int     @default(0)
}

// ---------- Testimonials ----------
model Testimonial {
  id          String  @id @default(cuid())
  clientName  String
  company     String?
  photoId     String?
  quote       String
  project     String?
  order       Int     @default(0)
}

// ---------- Inquiries ----------
enum InquiryStatus {
  NEW
  CONTACTED
  IN_PROGRESS
  COMPLETED
  REJECTED
}

model Inquiry {
  id              String        @id @default(cuid())
  name            String
  phone           String
  email           String?
  company         String?
  projectType     String?
  budget          String?
  description     String
  preferredContact String?
  status          InquiryStatus @default(NEW)
  adminNotes      String?
  createdAt       DateTime      @default(now())
}

// ---------- Contracts ----------
enum ContractStatus {
  DRAFT
  SENT
  SIGNED
  ARCHIVED
}

model Contract {
  id          String         @id @default(cuid())
  title       String
  clientName  String?
  projectId   String?
  pdfMediaId  String?
  status      ContractStatus @default(DRAFT)
  notes       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

// ---------- Social links (footer / contact) ----------
model SocialLink {
  id       String @id @default(cuid())
  platform String
  url      String
  order    Int    @default(0)
}

// ---------- Media library ----------
enum MediaType {
  IMAGE
  VIDEO
  PDF
}

model Media {
  id        String    @id @default(cuid())
  type      MediaType
  key       String    // storage key/path within the bucket
  url       String    // resolved public URL
  altText   String?
  width     Int?
  height    Int?
  createdAt DateTime  @default(now())
}
